{
  "openapi": "3.1.0",
  "info": {
    "title": "GitBuddy API",
    "description": "GitBuddy 内嵌 HTTP API，支持开发模式与远程访问。所有端点对应 Wails 绑定方法。 注意：本 spec 以 HTTP 路径形式镜像 GitBuddy 的 Wails 绑定面（方法名与载荷一一对应）；桌面应用本身不监听 HTTP 端口。",
    "version": "1.7.0",
    "contact": {
      "url": "https://github.com/sky-jiangcheng/gitbuddy"
    }
  },
  "servers": [
    {
      "url": "https://sky-jiangcheng.github.io/gitbuddy",
      "description": "文档镜像（非运行实例）"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "系统"
        ],
        "summary": "健康检查",
        "responses": {
          "200": {
            "description": "应用运行正常",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "version": "1.5.7"
                }
              }
            }
          }
        }
      }
    },
    "/summary": {
      "get": {
        "tags": [
          "统计"
        ],
        "summary": "获取汇总统计",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "日期 YYYY-MM-DD，默认昨天"
          }
        ],
        "responses": {
          "200": {
            "description": "汇总数据",
            "content": {
              "application/json": {
                "example": {
                  "date": "2024-06-15",
                  "repo_count": 12,
                  "total_files": 45,
                  "total_added": 3200,
                  "total_deleted": 800,
                  "my_added": 2100,
                  "my_deleted": 500,
                  "my_files": 28,
                  "is_workday": true
                }
              }
            }
          }
        }
      }
    },
    "/heatmap": {
      "get": {
        "tags": [
          "统计"
        ],
        "summary": "获取热力图数据",
        "responses": {
          "200": {
            "description": "全年每日统计",
            "content": {
              "application/json": {
                "example": {
                  "days": [
                    {
                      "date": "2024-06-15",
                      "lines_added": 300,
                      "lines_deleted": 50,
                      "commits": 5
                    }
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "description": "限定该项目的仓库（0/缺省为全局）",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ]
      }
    },
    "/status": {
      "get": {
        "tags": [
          "统计"
        ],
        "summary": "获取状态栏信息",
        "responses": {
          "200": {
            "description": "当前状态",
            "content": {
              "application/json": {
                "example": {
                  "current_time": "2024-06-15 14:30:00",
                  "last_commit_time": "2024-06-15 14:25:00",
                  "last_commit_repo": "my-project",
                  "last_commit_branch": "main",
                  "last_commit_msg": "feat: add search"
                }
              }
            }
          }
        }
      }
    },
    "/projects": {
      "get": {
        "tags": [
          "项目"
        ],
        "summary": "获取项目列表",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "日期 YYYY-MM-DD"
          },
          {
            "name": "starred_only",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "仅收藏项目"
          }
        ],
        "responses": {
          "200": {
            "description": "项目列表",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": 1,
                    "name": "my-project",
                    "root_path": "/Users/me/code/my-project",
                    "is_starred": true,
                    "repo_count": 2,
                    "total_added": 1200,
                    "total_deleted": 300,
                    "my_added": 800,
                    "my_deleted": 200,
                    "my_files": 15,
                    "is_workday": true,
                    "below_standard": false
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/projects/{id}/star": {
      "post": {
        "tags": [
          "项目"
        ],
        "summary": "收藏/取消收藏项目",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "收藏状态",
            "content": {
              "application/json": {
                "example": {
                  "starred": true
                }
              }
            }
          }
        }
      }
    },
    "/projects/{id}/refresh-history": {
      "post": {
        "tags": [
          "项目"
        ],
        "summary": "回填历史统计数据",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "触发成功"
          }
        }
      }
    },
    "/projects/{id}/overview": {
      "get": {
        "tags": [
          "项目"
        ],
        "summary": "项目概览（仓库知识挖掘）",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "挖掘结果",
            "content": {
              "application/json": {
                "example": {
                  "readme_excerpt": "# My Project",
                  "tech_stack": [
                    {
                      "name": "Go",
                      "category": "language"
                    }
                  ],
                  "languages": [
                    {
                      "language": "Go",
                      "count": 15000
                    }
                  ],
                  "dependencies": [
                    {
                      "name": "gin",
                      "version": "v1.9.1",
                      "source": "go"
                    }
                  ],
                  "top_contributors": [
                    {
                      "author": "John",
                      "count": 42
                    }
                  ],
                  "activity": {
                    "total_commits": 1580,
                    "active_days": 45,
                    "last_commit_date": "2024-06-15",
                    "commit_rate_30d": 28,
                    "active_months": 11
                  },
                  "recent_commits": [],
                  "cached": false
                }
              }
            }
          }
        }
      }
    },
    "/scan": {
      "post": {
        "tags": [
          "扫描"
        ],
        "summary": "触发仓库扫描",
        "responses": {
          "200": {
            "description": "扫描已启动",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "repos_found": 12,
                  "projects": 3,
                  "task_id": "123"
                }
              }
            }
          }
        }
      }
    },
    "/scan/status": {
      "get": {
        "tags": [
          "扫描"
        ],
        "summary": "查询扫描状态",
        "responses": {
          "200": {
            "description": "扫描进度",
            "content": {
              "application/json": {
                "example": {
                  "running": false,
                  "backfilling": false,
                  "progress": 0,
                  "total": 0
                }
              }
            }
          }
        }
      }
    },
    "/notes": {
      "get": {
        "tags": [
          "笔记"
        ],
        "summary": "获取项目笔记列表",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "项目 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "笔记列表"
          }
        }
      },
      "post": {
        "tags": [
          "笔记"
        ],
        "summary": "创建笔记",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "project_id": 1,
                "content": "# Hello",
                "title": "入门笔记",
                "tags": "guide",
                "kind": "knowledge"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建的笔记"
          }
        }
      }
    },
    "/notes/{id}": {
      "put": {
        "tags": [
          "笔记"
        ],
        "summary": "更新笔记内容",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "content": "# Updated"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功"
          }
        }
      },
      "delete": {
        "tags": [
          "笔记"
        ],
        "summary": "删除笔记",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功"
          }
        }
      }
    },
    "/notes/{id}/meta": {
      "put": {
        "tags": [
          "笔记"
        ],
        "summary": "更新笔记元数据",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "title": "新标题",
                "tags": "new-tag",
                "kind": "log",
                "pinned": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功"
          }
        }
      }
    },
    "/notes/{id}/pin": {
      "put": {
        "tags": [
          "笔记"
        ],
        "summary": "置顶/取消置顶笔记",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "pinned": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/notes/{id}/move": {
      "post": {
        "tags": [
          "笔记"
        ],
        "summary": "迁移笔记到其他项目",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "project_id": 2
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "迁移成功"
          }
        }
      }
    },
    "/notes/{id}/versions": {
      "get": {
        "tags": [
          "笔记"
        ],
        "summary": "获取笔记版本历史",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "版本列表"
          }
        }
      }
    },
    "/notes/{id}/versions/{vid}/restore": {
      "post": {
        "tags": [
          "笔记"
        ],
        "summary": "回滚笔记到历史版本",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "vid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "回滚成功"
          }
        }
      }
    },
    "/notes/{id}/versions/{vid}/diff": {
      "get": {
        "tags": [
          "笔记"
        ],
        "summary": "查看笔记版本差异",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "vid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "diff 文本"
          }
        }
      }
    },
    "/notes/all": {
      "get": {
        "tags": [
          "笔记"
        ],
        "summary": "获取所有项目笔记",
        "responses": {
          "200": {
            "description": "所有笔记列表"
          }
        }
      }
    },
    "/notes/tags": {
      "get": {
        "tags": [
          "笔记"
        ],
        "summary": "获取所有标签",
        "responses": {
          "200": {
            "description": "标签列表"
          }
        }
      }
    },
    "/todos": {
      "get": {
        "tags": [
          "待办"
        ],
        "summary": "获取项目待办列表",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "待办列表"
          }
        }
      },
      "post": {
        "tags": [
          "待办"
        ],
        "summary": "创建待办",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "project_id": 1,
                "title": "完成任务",
                "priority": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建的待办"
          }
        }
      }
    },
    "/todos/{id}/toggle": {
      "post": {
        "tags": [
          "待办"
        ],
        "summary": "切换待办完成状态",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/todos/{id}": {
      "delete": {
        "tags": [
          "待办"
        ],
        "summary": "删除待办",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功"
          }
        }
      }
    },
    "/search/notes": {
      "get": {
        "tags": [
          "搜索"
        ],
        "summary": "搜索笔记",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "搜索关键词"
          }
        ],
        "responses": {
          "200": {
            "description": "搜索结果",
            "content": {
              "application/json": {
                "example": [
                  {
                    "type": "note",
                    "id": 5,
                    "project_id": 1,
                    "project_name": "my-project",
                    "title": "入门笔记",
                    "snippet": "...关键词...",
                    "rank": 0.85
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/search/all": {
      "get": {
        "tags": [
          "搜索"
        ],
        "summary": "综合搜索（笔记+待办）",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "综合搜索结果"
          }
        }
      }
    },
    "/config": {
      "get": {
        "tags": [
          "配置"
        ],
        "summary": "获取配置",
        "responses": {
          "200": {
            "description": "配置与扫描根目录",
            "content": {
              "application/json": {
                "example": {
                  "config": {
                    "daily_code_standard": "500",
                    "scan_depth": "2"
                  },
                  "scan_roots": [
                    "/Users/me/code"
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "配置"
        ],
        "summary": "更新配置",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "key": "daily_code_standard",
                "value": "800"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功"
          }
        }
      }
    },
    "/config/scan-roots": {
      "put": {
        "tags": [
          "配置"
        ],
        "summary": "更新扫描根目录",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "scan_roots": [
                  "/Users/me/code",
                  "/Users/me/projects"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功"
          }
        }
      }
    },
    "/knowledge/import": {
      "post": {
        "tags": [
          "知识导入"
        ],
        "summary": "导入 Claude 记忆",
        "responses": {
          "200": {
            "description": "导入结果",
            "content": {
              "application/json": {
                "example": {
                  "synced": 5,
                  "updated": 2,
                  "skipped": 1
                }
              }
            }
          }
        }
      }
    },
    "/knowledge/sources": {
      "get": {
        "tags": [
          "知识导入"
        ],
        "summary": "获取导入源状态",
        "responses": {
          "200": {
            "description": "导入源列表"
          }
        }
      }
    },
    "/knowledge/import/{name}": {
      "post": {
        "tags": [
          "知识导入"
        ],
        "summary": "触发指定导入源",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "created": 3,
                  "updated": 1,
                  "skipped": 2
                }
              }
            }
          }
        }
      }
    },
    "/plugins": {
      "get": {
        "tags": [
          "插件"
        ],
        "summary": "获取插件状态",
        "responses": {
          "200": {
            "description": "插件列表",
            "content": {
              "application/json": {
                "example": [
                  {
                    "name": "my-plugin",
                    "enabled": true,
                    "error": ""
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/plugins/reload": {
      "post": {
        "tags": [
          "插件"
        ],
        "summary": "重载插件目录",
        "responses": {
          "200": {
            "description": "重载成功"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "root_path": {
            "type": "string"
          },
          "is_starred": {
            "type": "boolean"
          },
          "repo_count": {
            "type": "integer"
          },
          "total_added": {
            "type": "integer"
          },
          "total_deleted": {
            "type": "integer"
          },
          "my_added": {
            "type": "integer"
          },
          "my_deleted": {
            "type": "integer"
          },
          "my_files": {
            "type": "integer"
          },
          "is_workday": {
            "type": "boolean"
          },
          "below_standard": {
            "type": "boolean"
          }
        }
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "project_id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "tags": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "knowledge",
              "log",
              "idea",
              "other"
            ]
          },
          "pinned": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "SearchHit": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "note",
              "todo"
            ]
          },
          "id": {
            "type": "integer"
          },
          "project_id": {
            "type": "integer"
