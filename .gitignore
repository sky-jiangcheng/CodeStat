# Local user configuration overrides / 本地用户配置覆盖
.statistics.local

# Temporary files / 临时文件
*.tmp
*.swp
*.bak

# Built binaries (see scripts/build.sh) / 构建产物
gitboard
git-dashboard
gitboard-mcp
# gitboard-agent-score (merged into MCP tool)
gitbuddy
gitbuddy-mcp
gitbuddy-agent-score

# Database files / 数据库文件
*.db
*.db-shm
*.db-wal

# Node / Node 产物
web/node_modules/
web/dist/

# Generated icon assets / 图标产物（由 build/icon.svg 经 scripts/generate-icons.mjs 生成）
build/icons/
build/appicon.png

# Generated docs HTML (built from docs/**/*.md by scripts/build-docs.mjs)
docs/**/*.html

# AI tooling artifacts / AI 工具产物
.agents/
.trae-html-share-packages/
.workbuddy/
.zcode/
