# Local user configuration overrides / 本地用户配置覆盖
.statistics.local

# Temporary files / 临时文件
*.tmp
*.swp
*.bak

# Built binaries (see scripts/build.sh) / 构建产物
# Anchored with "/" so they only match repo-root binaries; unanchored patterns
# also swallowed cmd/mcp/ and hid cmd/mcp/results.go from version control.
/gitbuddy
/gitbuddy-mcp
/git-dashboard
/mcp

# Wails build output / Wails 构建输出
build/bin/
build/darwin/

# Wails frontend dependency cache / Wails 前端依赖缓存
web/package.json.md5

# Database files / 数据库文件
*.db
*.db-shm
*.db-wal

# Node / Node 产物
web/node_modules/
web/dist/

# Generated Wails JS bindings (regenerated by `wails build`; nothing in
# web/src imports them — the app calls window.go.app.App directly) / Wails
# 生成的前端绑定（wails build 时重新生成，web/src 未引用）
web/wailsjs/

# Generated icon assets / 图标产物（由 build/icon.svg 经 scripts/generate-icons.mjs 生成）
build/icons/
build/appicon.png

# Generated docs HTML (built from docs/**/*.md by scripts/build-docs.mjs)
docs/**/*.html

# AI tooling artifacts / AI 工具产物
.agents/
.claude/
.trae-html-share-packages/
.workbuddy/
.zcode/
